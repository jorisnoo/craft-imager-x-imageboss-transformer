{
    "name": "spacecatninja/imager-x-imageboss-transformer",
    "description": "ImageBoss transformer for Imager X",
    "type": "craft-plugin",
    "version": "3.1.0",
    "license": "MIT",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "image",
        "responsive",
        "transform",
        "srcset",
        "picture",
        "imageboss"
    ],
    "support": {
        "docs": "https://github.com/spacecatninja/craft-imager-x-imageboss-transformer/blob/master/README.md",
        "issues": "https://github.com/spacecatninja/craft-imager-x-imageboss-transformer/issues"
    },
    "authors": [
        {
            "name": "SPACECATNINJA",
            "homepage": "https://www.spacecat.ninja"
        }
    ],
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.0",
        "spacecatninja/imager-x": "^5.0 || ^6.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.5 || ^13.0"
    },
    "scripts": {
        "test": "phpunit --bootstrap tests/bootstrap.php tests",
        "analyse": "phpstan analyse --no-progress --memory-limit=512M"
    },
    "autoload": {
        "psr-4": {
          "spacecatninja\\imagebosstransformer\\": "src/"
        }
    },
    "extra": {
        "name": "Imager X ImageBoss Transformer",
        "handle": "imager-x-imageboss-transformer",
        "schemaVersion": "2.0.0",
        "hasCpSettings": false,
        "hasCpSection": false,
        "changelogUrl": "https://raw.githubusercontent.com/spacecatninja/craft-imager-x-imageboss-transformer/master/CHANGELOG.md",
        "components": {},
        "class": "spacecatninja\\imagebosstransformer\\ImageBossTransformer"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    }
}
